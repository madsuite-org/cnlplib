#!/bin/sh
# cnlp: install compiled optimization models (cnlp libraries) and solvers from the cnlplib
# registry, and solve the models.
#
#   cnlp list               available libraries for this platform, and what is installed
#   cnlp install [--device D] NAME...  install or update libraries ($CNLPLIB_HOME/lib/NAME), solvers
#                             ($CNLPLIB_HOME/solvers/NAME) or data sets
#                             ($CNLPLIB_HOME/data/NAME); a library brings
#                             the data sets it needs. NAME is the latest release,
#                             NAME@nightly the rolling build of the default branch,
#                             NAME@1.2.3 that version
#   cnlp up                 update everything installed (a pinned version stays)
#   cnlp solve ...          solve a model with an installed solver (see: cnlp solve --help)
#   cnlp remove NAME...     remove installed libraries, solvers or data sets
#   cnlp path               print the library directory (for CNLPLIB_PATH)
#   cnlp config list|get KEY|set KEY VALUE|unset KEY
#                           local settings in $CNLPLIB_HOME/config.toml: KEY is
#                             SECTION.NAME, e.g. artifacts.hsl (where an artifact is,
#                             instead of the store's copy)
#
# A library is published per backend: the host (CPU) build, and a build with a device tier
# (CUDA) as well. `install` takes the device build when this machine has that device
# (nvidia-smi lists a GPU) and the host build otherwise; --device cpu|cuda, or
# CNLPLIB_DEVICE, chooses instead.
#
# Environment: CNLPLIB_HOME (default ~/.cnlplib), CNLPLIB_INDEX (default the published index),
# CNLPLIB_DEVICE (cpu or cuda; default: detected).
set -eu

CNLPLIB_HOME="${CNLPLIB_HOME:-$HOME/.cnlplib}"
CNLPLIB_INDEX="${CNLPLIB_INDEX:-https://cnlplib.madsuite.org/index.tsv}"
LIBDIR="$CNLPLIB_HOME/lib"
ARTDIR="$CNLPLIB_HOME/artifacts"
DATADIR="$CNLPLIB_HOME/data"
SOLVERDIR="$CNLPLIB_HOME/solvers"

die() { echo "cnlp: $*" >&2; exit 1; }

platform() {
    case "$(uname -s)" in
        Linux) os=linux ;; Darwin) os=macos ;; MINGW*|MSYS*|CYGWIN*) os=windows ;;
        *) die "unsupported operating system $(uname -s)" ;;
    esac
    case "$(uname -m)" in
        x86_64|amd64) arch=x86_64 ;; aarch64|arm64) arch=aarch64 ;;
        *) die "unsupported architecture $(uname -m)" ;;
    esac
    echo "$os-$arch"
}

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
    else die "no sha256sum or shasum to verify downloads"; fi
}

fetch_index() {
    INDEX="$(mktemp "${TMPDIR:-/tmp}/cnlplib-index.XXXXXX")"
    curl -fsSL "$CNLPLIB_INDEX" -o "$INDEX" || die "could not download the index from $CNLPLIB_INDEX"
}

# The devices this machine can use, best first: `cuda` when nvidia-smi lists a GPU.
devices() {
    case "${CNLPLIB_DEVICE:-}" in
        "") if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L 2>/dev/null | grep -q '^GPU'; then echo cuda; fi ;;
        cpu) ;;
        cuda) echo cuda ;;
        *) die "unknown device '$CNLPLIB_DEVICE' (cpu or cuda)" ;;
    esac
}

# name label platform url sha256 description kind requires versioned-url backends
# (sha256 `-`: in the SHA256SUMS next to the asset; versioned-url has `{version}`), every line
# for this machine, best first: the platform with each usable device, then the host build
lookup_all() {
    for p in $(for d in $(devices); do echo "$PLAT-$d"; done) "$PLAT" any; do
        awk -F'\t' -v n="$1" -v p="$p" '$1 == n && $3 == p' "$INDEX"
    done
}
lookup() { lookup_all "$1" | head -n 1; }

# what is installed: "<version> <sha256> <request>"
installed() { cat "$LIBDIR/$1/.cnlplib-version" "$SOLVERDIR/$1/.cnlplib-version" "$DATADIR/$1/.cnlplib-version" 2>/dev/null | head -n 1; }

# what is installed, one line per entry: "<name>\t<release>[ (<device>)]"
installed_list() {
    for dir in "$LIBDIR" "$SOLVERDIR" "$DATADIR"; do
        [ -d "$dir" ] || continue
        for d in "$dir"/*/; do
            [ -d "$d" ] || continue
            n="$(basename "$d")"; v="$(cut -d' ' -f1 "$d/.cnlplib-version" 2>/dev/null || true)"
            dev="$(sed -n 's/^device = //p' "$d/VERSION" 2>/dev/null || true)"
            printf '%s\t%s%s\n' "$n" "${v:-by hand}" "${dev:+ ($dev)}"
        done
    done
}

# One row per name of a kind (lib, solver, data): its releases and backends merged, what is
# installed, and the description cut to the terminal's width.
list_table() {  # kind platform-prefix (empty: platform-independent) installed-file
    awk -F'\t' -v kind="$1" -v p="$2" -v inst="$3" -v width="${COLUMNS:-100}" '
        BEGIN { while ((getline l < inst) > 0) { split(l, f, "\t"); have[f[1]] = f[2] } }
        $7 == kind && (p == "" ? $3 == "any" : index($3, p) == 1) {
            n = $1; sub(/@.*/, "", n)
            if (!(n in desc)) { order[++k] = n; desc[n] = $6 }
            if (index(" " rel[n] " ", " " $2 " ") == 0) rel[n] = rel[n] (rel[n] == "" ? "" : " ") $2
            m = split($10, b, ",")
            for (i = 1; i <= m; i++)
                if (b[i] != "-" && b[i] != "" && index(" " be[n] " ", " " b[i] " ") == 0)
                    be[n] = be[n] (be[n] == "" ? "" : " ") b[i]
        }
        END {
            if (!k) { print "  (none yet)"; exit }
            printf "  %-12s %-16s %-10s %-16s %s\n", "NAME", "RELEASES", "BACKENDS", "INSTALLED", "DESCRIPTION"
            room = width - 2 - 13 - 17 - 11 - 17; if (room < 20) room = 20
            for (j = 1; j <= k; j++) {
                n = order[j]; r = rel[n]; gsub(/ /, ", ", r); e = be[n]; gsub(/ /, ",", e)
                if (e == "") e = "-"
                d = desc[n]; sub(/, [A-Za-z0-9]+\.jl$/, "", d)
                if (length(d) > room) d = substr(d, 1, room - 3) "..."
                printf "  %-12s %-16s %-10s %-16s %s\n", n, r, e, (n in have) ? have[n] : "-", d
            }
        }' "$INDEX"
}

cmd_list() {
    fetch_index
    inst="$(mktemp "${TMPDIR:-/tmp}/cnlplib-inst.XXXXXX")"; installed_list > "$inst"
    echo "Libraries for $PLAT:"; list_table lib "$PLAT" "$inst"
    echo "Solvers:"; list_table solver "$PLAT" "$inst"
    echo "Data sets:"; list_table data "" "$inst"
    rm -f "$INDEX" "$inst"
}

# NAME-HASH.artifact.tar.gz from a release directory URL, checked against its SHA256SUMS
install_artifact() {
    _a="$1"; _ab="$2"
    _aw="$(curl -fsSL "$_ab/SHA256SUMS" 2>/dev/null | awk -v f="$_a.artifact.tar.gz" '$2 == f || $2 == "*" f { print $1 }')"
    [ -n "$_aw" ] || die "no checksum for $_a.artifact.tar.gz in $_ab/SHA256SUMS"
    echo "Installing the shared artifact $_a"
    mkdir -p "$ARTDIR"; _as="$(mktemp -d "$ARTDIR/.stage-$_a.XXXXXX")"
    curl -fSL --progress-bar "$_ab/$_a.artifact.tar.gz" -o "$_as/a.tar.gz" || { rm -rf "$_as"; die "download failed: $_ab/$_a.artifact.tar.gz"; }
    [ "$(sha256 "$_as/a.tar.gz")" = "$_aw" ] || { rm -rf "$_as"; die "checksum mismatch for $_a"; }
    tar -xzf "$_as/a.tar.gz" -C "$_as"
    [ -d "$_as/$_a" ] || { rm -rf "$_as"; die "$_a.artifact.tar.gz has no top-level $_a/"; }
    mv "$_as/$_a" "$ARTDIR/$_a" 2>/dev/null || [ -d "$ARTDIR/$_a" ] || die "could not install $_a"
    rm -rf "$_as"
}

# The lib/julia of the official Julia VERSION into DEST: from a juliaup install of exactly
# that version if there is one, else from julialang.org's release, checked against its
# published SHA-256.
install_julia() {
    _jv="$1"; _jd="$2"
    for _jdir in "${JULIAUP_DEPOT_PATH:-$HOME/.julia}"/juliaup/julia-"$_jv"+*; do
        if [ -f "$_jdir/lib/libjulia.so.$_jv" ] && [ -d "$_jdir/lib/julia" ]; then
            # copied, not linked: removing that Julia with juliaup must not break the libraries
            mkdir -p "$ARTDIR"; _js="$(mktemp -d "$ARTDIR/.stage-julia-$_jv.XXXXXX")"
            cp -a "$_jdir/lib/julia" "$_js/julia" && mv "$_js/julia" "$_jd" 2>/dev/null || [ -d "$_jd" ] || die "could not copy Julia $_jv's runtime from $_jdir"
            rm -rf "$_js"; echo "Installed the Julia $_jv runtime from $_jdir"; return
        fi
    done
    case "$PLAT" in
        linux-x86_64) _jf="julia-$_jv-linux-x86_64.tar.gz"; _jsub="linux/x64" ;;
        linux-aarch64) _jf="julia-$_jv-linux-aarch64.tar.gz"; _jsub="linux/aarch64" ;;
        *) die "no official Julia download known for $PLAT" ;;
    esac
    _jmm="${_jv%.*}"; _ju="https://julialang-s3.julialang.org/bin/$_jsub/$_jmm/$_jf"
    _jw="$(curl -fsSL "https://julialang-s3.julialang.org/bin/checksums/julia-$_jv.sha256" 2>/dev/null | awk -v f="$_jf" '$2 == f { print $1 }')"
    [ -n "$_jw" ] || die "no published checksum for $_jf"
    echo "Installing the Julia $_jv runtime from $_ju"
    mkdir -p "$ARTDIR"; _js="$(mktemp -d "$ARTDIR/.stage-julia-$_jv.XXXXXX")"
    curl -fSL --progress-bar "$_ju" -o "$_js/j.tar.gz" || { rm -rf "$_js"; die "download failed: $_ju"; }
    [ "$(sha256 "$_js/j.tar.gz")" = "$_jw" ] || { rm -rf "$_js"; die "checksum mismatch for $_jf"; }
    tar -xzf "$_js/j.tar.gz" -C "$_js" "julia-$_jv/lib/julia"
    mv "$_js/julia-$_jv/lib/julia" "$_jd" 2>/dev/null || [ -d "$_jd" ] || die "could not install Julia $_jv's runtime"
    rm -rf "$_js"
}

install_one() {
    req="$1"; n="${req%%@*}"; sel=""
    case "$req" in *@*) sel="${req#*@}" ;; esac
    case "$sel" in
        ""|latest) line="$(lookup "$n")" ;;
        nightly) line="$(lookup "$n@nightly")" ;;
        *) line="$(lookup "$n")" ;;
    esac
    [ -n "$line" ] || die "no '$req' for $PLAT in the index (see: cnlp list)"
    # data sets it needs first (sh has no locals: re-read this entry's fields afterwards)
    for r in $(printf '%s' "$line" | cut -f8 | tr ',' ' '); do install_one "$r"; done
    req="$1"; n="${req%%@*}"; sel=""
    case "$req" in *@*) sel="${req#*@}" ;; esac
    case "$sel" in ""|latest) line="$(lookup "$n")" ;; nightly) line="$(lookup "$n@nightly")" ;; *) line="$(lookup "$n")" ;; esac
    key="$n"; [ "$sel" = nightly ] && key="$n@nightly"
    # the first build, best first, that the release actually carries (a library released before
    # its device build was published has only the host build)
    cands="$(mktemp "${TMPDIR:-/tmp}/cnlplib-cands.XXXXXX")"; lookup_all "$key" > "$cands"
    want=""
    while IFS= read -r line; do
        ver="$(printf '%s' "$line" | cut -f2)"; url="$(printf '%s' "$line" | cut -f4)"; want="$(printf '%s' "$line" | cut -f5)"
        kind="$(printf '%s' "$line" | cut -f7)"; tmpl="$(printf '%s' "$line" | cut -f9)"
        build="$(printf '%s' "$line" | cut -f3)"
        case "$sel" in
            ""|latest|nightly) ;;
            *)  [ -n "$tmpl" ] && [ "$tmpl" != "-" ] || { want=""; continue; }
                url="$(printf '%s' "$tmpl" | sed "s/{version}/$sel/g")"; ver="$sel"; want="-" ;;
        esac
        if [ "$want" = "-" ]; then
            # published with the asset: the SHA256SUMS of the same release
            want="$(curl -fsSL "${url%/*}/SHA256SUMS" 2>/dev/null | awk -v f="${url##*/}" '$2 == f || $2 == "*" f { print $1 }')"
        fi
        [ -n "$want" ] && break
    done < "$cands"
    rm -f "$cands"
    [ -n "$want" ] || die "no released build of '$req' for $PLAT (is it released? see: cnlp list)"
    dest="$LIBDIR"; [ "$kind" = data ] && dest="$DATADIR"; [ "$kind" = solver ] && dest="$SOLVERDIR"
    cur="$(installed "$n")"
    if [ "$(printf '%s' "$cur" | cut -d' ' -f2)" = "$want" ]; then
        # same bytes: record the request, so `up` follows the channel asked for last
        f="$dest/$n/.cnlplib-version"; echo "${cur%% *} $want $req" > "$f"
        echo "$req is up to date"; return
    fi
    echo "Installing $req ($build)"
    mkdir -p "$dest"
    stage="$(mktemp -d "$dest/.stage-$n.XXXXXX")"
    trap 'rm -rf "$stage"' EXIT INT TERM
    curl -fSL --progress-bar "$url" -o "$stage/asset.tar.gz" || die "download failed: $url"
    got="$(sha256 "$stage/asset.tar.gz")"
    [ "$got" = "$want" ] || die "checksum mismatch for $req: expected $want, got $got"
    mkdir "$stage/x"; tar -xzf "$stage/asset.tar.gz" -C "$stage/x"
    # the asset's content, or its single top-level directory
    src="$stage/x"
    if [ "$(ls -A "$src" | wc -l)" -eq 1 ] && [ -d "$src/$(ls -A "$src")" ]; then src="$src/$(ls -A "$src")"; fi
    case "$kind" in
        lib) ls "$src/lib/lib$n".* >/dev/null 2>&1 || die "the asset for $req has no lib/lib$n.<ext>" ;;
        solver) ls "$src/lib/libcnlp_$n".* >/dev/null 2>&1 || die "the asset for $req has no lib/libcnlp_$n.<ext>" ;;
    esac
    # shared artifacts (ARTIFACTS: `ARTIFACT TARGET` lines), each installed once into
    # $ARTDIR and its files linked into the library's TARGET (a file the library carries wins)
    if [ -f "$src/ARTIFACTS" ]; then
        while read -r a t; do
            [ -n "$a" ] || continue
            case "/$t/" in */../*|//*) die "the asset for $req links $a into '$t', outside the library" ;; esac
            if printf '%s' "$a" | grep -Eq '^julia-[0-9]+\.[0-9]+\.[0-9]+$'; then
                ad="$ARTDIR/$a-$PLAT"; [ -d "$ad" ] || install_julia "${a#julia-}" "$ad"
            elif printf '%s' "$a" | grep -Eq '^[a-z0-9_]+-[0-9a-f]{16,64}$'; then
                ad="$ARTDIR/$a"; [ -d "$ad" ] || install_artifact "$a" "${url%/*}"
            else
                die "the asset for $req names an invalid artifact '$a'"
            fi
            mkdir -p "$src/$t"
            for f in $(ls -A "$ad"); do
                [ -e "$src/$t/$f" ] || [ -L "$src/$t/$f" ] || ln -s "$ad/$f" "$src/$t/$f"
            done
        done < "$src/ARTIFACTS"
    fi
    # the version the asset says it is, if it says
    v="$(sed -n 's/^version *= *//p' "$src/VERSION" 2>/dev/null | head -n 1)"; [ -n "$v" ] && ver="$v"
    echo "$ver $want $req" > "$src/.cnlplib-version"
    # swap into place: a failed install never leaves a half-installed library
    rm -rf "$dest/.old-$n"
    [ -d "$dest/$n" ] && mv "$dest/$n" "$dest/.old-$n"
    mv "$src" "$dest/$n"
    rm -rf "$dest/.old-$n" "$stage"
    trap - EXIT INT TERM
    echo "Installed $n $ver in $dest/$n"
    privatize
}

# Private names for the store's bundled libraries (OpenSSL, curl, libstdc++, ...), so that a
# process that has already loaded its own copies (Python's hashlib loads the system OpenSSL)
# cannot be handed them in place of the bundle's: cnlp-solve --privatize, see solve/privatize.h.
privatize() {
    _ps="$CNLPLIB_HOME/bin/cnlp-solve"; [ -x "$_ps" ] || _ps="$(command -v cnlp-solve 2>/dev/null)" || return 0
    "$_ps" --privatize || echo "cnlp: could not give the bundled libraries private names" >&2
}

cmd_install() {
    if [ "${1:-}" = --device ]; then [ "$#" -ge 2 ] || die "usage: cnlp install --device cpu|cuda NAME..."; CNLPLIB_DEVICE="$2"; shift 2; fi
    [ "$#" -gt 0 ] || die "usage: cnlp install [--device cpu|cuda] NAME..."
    devices > /dev/null   # an unknown CNLPLIB_DEVICE stops here, not inside a lookup
    fetch_index
    for n in "$@"; do install_one "$n"; done
    rm -f "$INDEX"
}

cmd_up() {
    names=""
    for dir in "$LIBDIR" "$SOLVERDIR" "$DATADIR"; do
        [ -d "$dir" ] || continue
        for d in "$dir"/*/; do
            [ -d "$d" ] || continue
            # reinstall what was asked for: NAME, NAME@nightly, or a pinned NAME@1.2.3; an
            # entry installed by hand (no release record) is not cnlp's to update
            if [ ! -f "$d/.cnlplib-version" ]; then
                echo "skipping $(basename "$d"): installed by hand, not from the registry"
                continue
            fi
            r="$(cut -d' ' -f3 "$d/.cnlplib-version")"
            names="$names ${r:-$(basename "$d")}"
        done
    done
    [ -n "$names" ] || { echo "nothing installed"; return; }
    # shellcheck disable=SC2086
    cmd_install $names
}

cmd_remove() {
    [ "$#" -gt 0 ] || die "usage: cnlp remove NAME..."
    for n in "$@"; do
        if [ -d "$LIBDIR/$n" ]; then rm -rf "${LIBDIR:?}/$n"
        elif [ -d "$SOLVERDIR/$n" ]; then rm -rf "${SOLVERDIR:?}/$n"
        elif [ -d "$DATADIR/$n" ]; then rm -rf "${DATADIR:?}/$n"
        else die "$n is not installed"; fi
        echo "Removed $n"
    done
}

# ── config: $CNLPLIB_HOME/config.toml, sections of `name = "value"` lines ─────────────────
# KEY is SECTION.NAME, split at the first dot (artifacts.cuda-12.9 is section artifacts,
# name cuda-12.9). A name that is not a bare TOML key (letters, digits, - and _) is written
# quoted; values are strings.
CONFIG="$CNLPLIB_HOME/config.toml"
config_split() {
    case "$1" in *.*) ;; *) die "a config key is SECTION.NAME (e.g. artifacts.hsl), not '$1'" ;; esac
    sec="${1%%.*}"; name="${1#*.}"
    [ -n "$sec" ] && [ -n "$name" ] || die "a config key is SECTION.NAME (e.g. artifacts.hsl), not '$1'"
}
# every setting as SECTION.NAME<TAB>VALUE
config_dump() {
    [ -f "$CONFIG" ] || return 0
    awk '
        /^[ \t]*(#|$)/ { next }
        /^[ \t]*\[/ { s = $0; sub(/^[ \t]*\[[ \t]*/, "", s); sub(/[ \t]*\].*$/, "", s); next }
        {
            line = $0; eq = index(line, "="); if (!eq) next
            k = substr(line, 1, eq - 1); v = substr(line, eq + 1)
            gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
            if (k ~ /^".*"$/) k = substr(k, 2, length(k) - 2)
            if (v ~ /^".*"$/) { v = substr(v, 2, length(v) - 2); gsub(/\\"/, "\"", v); gsub(/\\\\/, "\\", v) }
            print s "." k "\t" v
        }' "$CONFIG"
}
# the file again from SECTION.NAME<TAB>VALUE lines (sorted), with a header
config_write() {
    mkdir -p "$CNLPLIB_HOME"
    tmp="$CONFIG.tmp.$$"
    {
        echo "# cnlp settings (cnlp config set/unset); see https://cnlplib.madsuite.org/cli/"
        sort | awk -F '\t' '
            {
                d = index($1, "."); sec = substr($1, 1, d - 1); k = substr($1, d + 1); v = $2
                if (sec != last) { if (NR > 1) print ""; print "[" sec "]"; last = sec }
                if (k !~ /^[A-Za-z0-9_-]+$/) k = "\"" k "\""
                gsub(/\\/, "\\\\", v); gsub(/"/, "\\\"", v)
                print k " = \"" v "\""
            }'
    } > "$tmp"
    mv "$tmp" "$CONFIG"
}
cmd_config() {
    sub="${1:-list}"; [ $# -gt 0 ] && shift
    case "$sub" in
        list) config_dump | awk -F '\t' '{ print $1 " = " $2 }' ;;
        get) [ $# -eq 1 ] || die "usage: cnlp config get SECTION.NAME"
            config_split "$1"
            v="$(config_dump | awk -F '\t' -v k="$1" '$1 == k { print $2; f = 1 } END { exit !f }')" || exit 1
            printf '%s\n' "$v" ;;
        set) [ $# -eq 2 ] || die "usage: cnlp config set SECTION.NAME VALUE"
            config_split "$1"
            { config_dump | awk -F '\t' -v k="$1" '$1 != k'; printf '%s\t%s\n' "$1" "$2"; } | config_write ;;
        unset) [ $# -eq 1 ] || die "usage: cnlp config unset SECTION.NAME"
            config_split "$1"
            config_dump | awk -F '\t' -v k="$1" '$1 != k' | config_write ;;
        *) die "unknown config command '$sub' (list, get, set, unset)" ;;
    esac
}

PLAT="$(platform)"
case "${1:-}" in
    list) cmd_list ;;
    install) shift; cmd_install "$@" ;;
    up|update) cmd_up ;;
    remove|uninstall) shift; cmd_remove "$@" ;;
    path) echo "$LIBDIR" ;;
    config) shift; cmd_config "$@" ;;
    solve) shift
        d="$CNLPLIB_HOME/bin/cnlp-solve"
        [ -x "$d" ] || d="$(command -v cnlp-solve 2>/dev/null)" || die "cnlp-solve is not installed (rerun the installer)"
        exec "$d" "$@" ;;
    ""|-h|--help|help) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (see: cnlp help)" ;;
esac
