#!/bin/sh
# cnlp: install compiled optimization models (cnlp libraries) and solvers from the cnlplib
# registry, and solve the models.
#
#   cnlp list               available libraries for this platform, and what is installed
#   cnlp install [--device D] NAME...  install or update libraries ($CNLPLIB_HOME/lib/NAME), solvers
#                             ($CNLPLIB_HOME/solvers/NAME) or data sets
#                             ($CNLPLIB_HOME/data/NAME); a library brings
#                             the data sets it needs. NAME is the latest release,
#                             NAME@nightly the rolling build of the default branch,
#                             NAME@1.2.3 that version
#   cnlp up                 update everything installed (a pinned version stays)
#   cnlp solve ...          solve a model with an installed solver (see: cnlp solve --help)
#   cnlp remove NAME...     remove installed libraries, solvers or data sets
#   cnlp path               print the library directory (for CNLPLIB_PATH)
#
# A library is published per backend: the host (CPU) build, and a build with a device tier
# (CUDA) as well. `install` takes the device build when this machine has that device
# (nvidia-smi lists a GPU) and the host build otherwise; --device cpu|cuda, or
# CNLPLIB_DEVICE, chooses instead.
#
# Environment: CNLPLIB_HOME (default ~/.cnlplib), CNLPLIB_INDEX (default the published index),
# CNLPLIB_DEVICE (cpu or cuda; default: detected).
set -eu

CNLPLIB_HOME="${CNLPLIB_HOME:-$HOME/.cnlplib}"
CNLPLIB_INDEX="${CNLPLIB_INDEX:-https://cnlplib.madsuite.org/index.tsv}"
LIBDIR="$CNLPLIB_HOME/lib"
ARTDIR="$CNLPLIB_HOME/artifacts"
DATADIR="$CNLPLIB_HOME/data"
SOLVERDIR="$CNLPLIB_HOME/solvers"

die() { echo "cnlp: $*" >&2; exit 1; }

platform() {
    case "$(uname -s)" in
        Linux) os=linux ;; Darwin) os=macos ;; MINGW*|MSYS*|CYGWIN*) os=windows ;;
        *) die "unsupported operating system $(uname -s)" ;;
    esac
    case "$(uname -m)" in
        x86_64|amd64) arch=x86_64 ;; aarch64|arm64) arch=aarch64 ;;
        *) die "unsupported architecture $(uname -m)" ;;
    esac
    echo "$os-$arch"
}

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
    else die "no sha256sum or shasum to verify downloads"; fi
}

fetch_index() {
    INDEX="$(mktemp "${TMPDIR:-/tmp}/cnlplib-index.XXXXXX")"
    curl -fsSL "$CNLPLIB_INDEX" -o "$INDEX" || die "could not download the index from $CNLPLIB_INDEX"
}

# The devices this machine can use, best first: `cuda` when nvidia-smi lists a GPU.
devices() {
    case "${CNLPLIB_DEVICE:-}" in
        "") if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L 2>/dev/null | grep -q '^GPU'; then echo cuda; fi ;;
        cpu) ;;
        cuda) echo cuda ;;
        *) die "unknown device '$CNLPLIB_DEVICE' (cpu or cuda)" ;;
    esac
}

# name label platform url sha256 description kind requires versioned-url backends
# (sha256 `-`: in the SHA256SUMS next to the asset; versioned-url has `{version}`), every line
# for this machine, best first: the platform with each usable device, then the host build
lookup_all() {
    for p in $(for d in $(devices); do echo "$PLAT-$d"; done) "$PLAT" any; do
        awk -F'\t' -v n="$1" -v p="$p" '$1 == n && $3 == p' "$INDEX"
    done
}
lookup() { lookup_all "$1" | head -n 1; }

# what is installed: "<version> <sha256> <request>"
installed() { cat "$LIBDIR/$1/.cnlplib-version" "$SOLVERDIR/$1/.cnlplib-version" "$DATADIR/$1/.cnlplib-version" 2>/dev/null | head -n 1; }

list_dir() {
    found=0
    if [ -d "$1" ]; then
        for d in "$1"/*/; do
            [ -d "$d" ] || continue
            n="$(basename "$d")"; i="$(cat "$d/.cnlplib-version" 2>/dev/null)"
            printf "  %-14s %-16s %s\n" "$n" "${i%% *}" "$(printf '%s' "$i" | cut -d' ' -f3)"; found=1
        done
    fi
    [ "$found" = 1 ] || echo "  (none)"
}

cmd_list() {
    fetch_index
    echo "Libraries for $PLAT (from $CNLPLIB_INDEX):"
    printf "  %-14s %-10s %-10s %s\n" NAME RELEASE BACKENDS DESCRIPTION
    awk -F'\t' -v p="$PLAT" 'index($3, p) == 1 && $7 == "lib" { printf "  %-14s %-10s %-10s %s\n", $1, $2, $10, $6; n++ } END { if (!n) print "  (none yet)" }' "$INDEX"
    echo "Solvers:"
    awk -F'\t' -v p="$PLAT" '$3 == p && $7 == "solver" { printf "  %-14s %-10s %-10s %s\n", $1, $2, $10, $6; n++ } END { if (!n) print "  (none yet)" }' "$INDEX"
    echo "Data sets:"
    awk -F'\t' '$3 == "any" { printf "  %-14s %-16s %s\n", $1, $2, $6; n++ } END { if (!n) print "  (none yet)" }' "$INDEX"
    echo "Installed in $LIBDIR:"; list_dir "$LIBDIR"
    echo "Installed in $SOLVERDIR:"; list_dir "$SOLVERDIR"
    echo "Installed in $DATADIR:"; list_dir "$DATADIR"
    rm -f "$INDEX"
}

install_one() {
    req="$1"; n="${req%%@*}"; sel=""
    case "$req" in *@*) sel="${req#*@}" ;; esac
    case "$sel" in
        ""|latest) line="$(lookup "$n")" ;;
        nightly) line="$(lookup "$n@nightly")" ;;
        *) line="$(lookup "$n")" ;;
    esac
    [ -n "$line" ] || die "no '$req' for $PLAT in the index (see: cnlp list)"
    # data sets it needs first (sh has no locals: re-read this entry's fields afterwards)
    for r in $(printf '%s' "$line" | cut -f8 | tr ',' ' '); do install_one "$r"; done
    req="$1"; n="${req%%@*}"; sel=""
    case "$req" in *@*) sel="${req#*@}" ;; esac
    case "$sel" in ""|latest) line="$(lookup "$n")" ;; nightly) line="$(lookup "$n@nightly")" ;; *) line="$(lookup "$n")" ;; esac
    key="$n"; [ "$sel" = nightly ] && key="$n@nightly"
    # the first build, best first, that the release actually carries (a library released before
    # its device build was published has only the host build)
    cands="$(mktemp "${TMPDIR:-/tmp}/cnlplib-cands.XXXXXX")"; lookup_all "$key" > "$cands"
    want=""
    while IFS= read -r line; do
        ver="$(printf '%s' "$line" | cut -f2)"; url="$(printf '%s' "$line" | cut -f4)"; want="$(printf '%s' "$line" | cut -f5)"
        kind="$(printf '%s' "$line" | cut -f7)"; tmpl="$(printf '%s' "$line" | cut -f9)"
        build="$(printf '%s' "$line" | cut -f3)"
        case "$sel" in
            ""|latest|nightly) ;;
            *)  [ -n "$tmpl" ] && [ "$tmpl" != "-" ] || { want=""; continue; }
                url="$(printf '%s' "$tmpl" | sed "s/{version}/$sel/g")"; ver="$sel"; want="-" ;;
        esac
        if [ "$want" = "-" ]; then
            # published with the asset: the SHA256SUMS of the same release
            want="$(curl -fsSL "${url%/*}/SHA256SUMS" 2>/dev/null | awk -v f="${url##*/}" '$2 == f || $2 == "*" f { print $1 }')"
        fi
        [ -n "$want" ] && break
    done < "$cands"
    rm -f "$cands"
    [ -n "$want" ] || die "no released build of '$req' for $PLAT (is it released? see: cnlp list)"
    dest="$LIBDIR"; [ "$kind" = data ] && dest="$DATADIR"; [ "$kind" = solver ] && dest="$SOLVERDIR"
    cur="$(installed "$n")"
    if [ "$(printf '%s' "$cur" | cut -d' ' -f2)" = "$want" ]; then
        # same bytes: record the request, so `up` follows the channel asked for last
        f="$dest/$n/.cnlplib-version"; echo "${cur%% *} $want $req" > "$f"
        echo "$req is up to date"; return
    fi
    echo "Installing $req ($build)"
    mkdir -p "$dest"
    stage="$(mktemp -d "$dest/.stage-$n.XXXXXX")"
    trap 'rm -rf "$stage"' EXIT INT TERM
    curl -fSL --progress-bar "$url" -o "$stage/asset.tar.gz" || die "download failed: $url"
    got="$(sha256 "$stage/asset.tar.gz")"
    [ "$got" = "$want" ] || die "checksum mismatch for $req: expected $want, got $got"
    mkdir "$stage/x"; tar -xzf "$stage/asset.tar.gz" -C "$stage/x"
    # the asset's content, or its single top-level directory
    src="$stage/x"
    if [ "$(ls -A "$src" | wc -l)" -eq 1 ] && [ -d "$src/$(ls -A "$src")" ]; then src="$src/$(ls -A "$src")"; fi
    case "$kind" in
        lib) ls "$src/lib/lib$n".* >/dev/null 2>&1 || die "the asset for $req has no lib/lib$n.<ext>" ;;
        solver) ls "$src/lib/libcnlp_$n".* >/dev/null 2>&1 || die "the asset for $req has no lib/libcnlp_$n.<ext>" ;;
    esac
    # a library sharing a runtime (RUNTIME): fetch it once, from the same release, and link it in
    if [ -f "$src/RUNTIME" ]; then
        rt="$(sed -n 's/^runtime = //p' "$src/RUNTIME")"
        case "$rt" in runtime-[0-9a-f]*) ;; *) die "the asset for $req names no valid runtime" ;; esac
        if [ ! -d "$ARTDIR/$rt" ]; then
            rurl="${url%/*}/$rt.tar.gz"
            rwant="$(curl -fsSL "${url%/*}/SHA256SUMS" 2>/dev/null | awk -v f="$rt.tar.gz" '$2 == f || $2 == "*" f { print $1 }')"
            [ -n "$rwant" ] || die "no checksum for $rt.tar.gz in ${url%/*}/SHA256SUMS"
            echo "Installing the shared runtime $rt"
            curl -fSL --progress-bar "$rurl" -o "$stage/runtime.tar.gz" || die "download failed: $rurl"
            [ "$(sha256 "$stage/runtime.tar.gz")" = "$rwant" ] || die "checksum mismatch for $rt"
            mkdir -p "$ARTDIR"; rstage="$(mktemp -d "$ARTDIR/.stage-$rt.XXXXXX")"
            tar -xzf "$stage/runtime.tar.gz" -C "$rstage"
            [ -d "$rstage/$rt/julia" ] || { rm -rf "$rstage"; die "$rt.tar.gz has no $rt/julia"; }
            mv "$rstage/$rt" "$ARTDIR/$rt" 2>/dev/null || [ -d "$ARTDIR/$rt" ] || die "could not install $rt"
            rm -rf "$rstage"
        fi
        mkdir -p "$src/lib/julia"
        for f in $(ls -A "$ARTDIR/$rt/julia"); do ln -sfn "$ARTDIR/$rt/julia/$f" "$src/lib/julia/$f"; done
    fi
    # the version the asset says it is, if it says
    v="$(sed -n 's/^version *= *//p' "$src/VERSION" 2>/dev/null | head -n 1)"; [ -n "$v" ] && ver="$v"
    echo "$ver $want $req" > "$src/.cnlplib-version"
    # swap into place: a failed install never leaves a half-installed library
    rm -rf "$dest/.old-$n"
    [ -d "$dest/$n" ] && mv "$dest/$n" "$dest/.old-$n"
    mv "$src" "$dest/$n"
    rm -rf "$dest/.old-$n" "$stage"
    trap - EXIT INT TERM
    echo "Installed $n $ver in $dest/$n"
}

cmd_install() {
    if [ "${1:-}" = --device ]; then [ "$#" -ge 2 ] || die "usage: cnlp install --device cpu|cuda NAME..."; CNLPLIB_DEVICE="$2"; shift 2; fi
    [ "$#" -gt 0 ] || die "usage: cnlp install [--device cpu|cuda] NAME..."
    devices > /dev/null   # an unknown CNLPLIB_DEVICE stops here, not inside a lookup
    fetch_index
    for n in "$@"; do install_one "$n"; done
    rm -f "$INDEX"
}

cmd_up() {
    names=""
    for dir in "$LIBDIR" "$SOLVERDIR" "$DATADIR"; do
        [ -d "$dir" ] || continue
        for d in "$dir"/*/; do
            [ -d "$d" ] || continue
            # reinstall what was asked for: NAME, NAME@nightly, or a pinned NAME@1.2.3
            r="$(cut -d' ' -f3 "$d/.cnlplib-version" 2>/dev/null)"
            names="$names ${r:-$(basename "$d")}"
        done
    done
    [ -n "$names" ] || { echo "nothing installed"; return; }
    # shellcheck disable=SC2086
    cmd_install $names
}

cmd_remove() {
    [ "$#" -gt 0 ] || die "usage: cnlp remove NAME..."
    for n in "$@"; do
        if [ -d "$LIBDIR/$n" ]; then rm -rf "${LIBDIR:?}/$n"
        elif [ -d "$SOLVERDIR/$n" ]; then rm -rf "${SOLVERDIR:?}/$n"
        elif [ -d "$DATADIR/$n" ]; then rm -rf "${DATADIR:?}/$n"
        else die "$n is not installed"; fi
        echo "Removed $n"
    done
}

PLAT="$(platform)"
case "${1:-}" in
    list) cmd_list ;;
    install) shift; cmd_install "$@" ;;
    up|update) cmd_up ;;
    remove|uninstall) shift; cmd_remove "$@" ;;
    path) echo "$LIBDIR" ;;
    solve) shift
        d="$CNLPLIB_HOME/bin/cnlp-solve"
        [ -x "$d" ] || d="$(command -v cnlp-solve 2>/dev/null)" || die "cnlp-solve is not installed (rerun the installer)"
        exec "$d" "$@" ;;
    ""|-h|--help|help) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (see: cnlp help)" ;;
esac
